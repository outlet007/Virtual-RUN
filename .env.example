# Supabase — เอาค่าจาก Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ใช้เฉพาะฝั่ง server (Phase 2 admin) — ข้าม RLS ทั้งหมด ห้าม expose ฝั่ง client เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Strava — เอาค่าจาก strava.com/settings/api (Phase 3)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
# ตั้งเองเป็น string สุ่มอะไรก็ได้ ใช้ตอน subscribe webhook (ไม่ใช่ค่าจาก Strava)
STRAVA_WEBHOOK_VERIFY_TOKEN=your-own-random-verify-token

# PromptPay (Phase 4) — เบอร์โทร/เลขบัตรประชาชน/เลข eWallet ที่จะรับเงิน — gen QR เอง ไม่ผ่าน gateway
# ระบบไม่ยืนยันการจ่ายอัตโนมัติ ต้องให้ admin กดยืนยันเองที่ /admin/payments หลังเช็คยอดเงินเข้า
PROMPTPAY_ID=0812345678

# Email (Phase 6) — SMTP ธรรมดา (เช่น Gmail SMTP หรือของ hosting เอง)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Virtual RUN <noreply@example.com>"

# LINE (Phase 6) — ต้องสร้าง 2 channel แยกกันใน LINE Developers Console (provider เดียวกัน)
# 1) LINE Login channel — ใช้ตอน user เชื่อมบัญชี (ได้ LINE user ID มาเก็บใน users.line_user_id)
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
# 2) Messaging API channel — token เดียวของแอป ใช้ push ข้อความหาทุกคน (ไม่ใช่ token ต่อ user)
LINE_CHANNEL_ACCESS_TOKEN=your-line-messaging-channel-access-token

# Social login (Google/Facebook) — เอาจาก Google Cloud Console / Meta for Developers
# หลังใส่ค่าแล้วต้องเปิด enabled=true ใน supabase/config.toml ด้วย แล้ว `supabase stop && supabase start` (ไม่ใช่แค่ migration up)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
