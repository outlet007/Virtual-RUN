# Supabase — เอาค่าจาก Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ใช้เฉพาะฝั่ง server (Phase 2 admin) — ข้าม RLS ทั้งหมด ห้าม expose ฝั่ง client เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Strava — เอาค่าจาก strava.com/settings/api (Phase 3)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
# ตั้งเองเป็น string สุ่มอะไรก็ได้ ใช้ตอน subscribe webhook (ไม่ใช่ค่าจาก Strava)
STRAVA_WEBHOOK_VERIFY_TOKEN=your-own-random-verify-token

# (Phase หลัง) LINE / Payment — ยังไม่ใช้
# LINE_CHANNEL_ACCESS_TOKEN=
