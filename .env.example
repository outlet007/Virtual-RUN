# Application and container timezone. Database/JWT timestamps remain UTC epochs.
TZ=Asia/Bangkok

# Supabase — เอาค่าจาก Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Preferred for hosted projects (sb_publishable_...). Leave blank to use anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL ที่ browser ใช้จริงสำหรับ redirect หลัง login/logout
# Local Docker ใช้ http://localhost:8025 และ production ให้เปลี่ยนเป็นโดเมนจริง
SITE_URL=http://localhost:8025
# Public contact shown on the privacy and data-deletion pages.
PRIVACY_CONTACT_EMAIL=

# ใช้เฉพาะฝั่ง server (Phase 2 admin) — ข้าม RLS ทั้งหมด ห้าม expose ฝั่ง client เด็ดขาด
# Preferred server-only key for hosted projects (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy/local fallback. Never expose either elevated key to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile — ป้องกัน bot ที่หน้า login
# เปลี่ยนเป็น keys จาก Cloudflare Dashboard ก่อน deploy production
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production แนะนำให้ล็อก hostname เช่น run.example.com
TURNSTILE_EXPECTED_HOSTNAME=

# Strava — เอาค่าจาก strava.com/settings/api (Phase 3)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
# ตั้งเองเป็น string สุ่มอะไรก็ได้ ใช้ตอน subscribe webhook (ไม่ใช่ค่าจาก Strava)
STRAVA_WEBHOOK_VERIFY_TOKEN=your-own-random-verify-token

# PromptPay (Phase 4) — เบอร์โทร/เลขบัตรประชาชน/เลข eWallet ที่จะรับเงิน — gen QR เอง ไม่ผ่าน gateway
# ระบบไม่ยืนยันการจ่ายอัตโนมัติ ต้องให้ admin กดยืนยันเองที่ /admin/payments หลังเช็คยอดเงินเข้า
PROMPTPAY_ID=0812345678

# Email (Phase 6) — SMTP ธรรมดา (เช่น Gmail SMTP หรือของ hosting เอง)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Virtual RUN <noreply@example.com>"
# Master key สำหรับเข้ารหัส SMTP/Strava/LINE/Turnstile/PromptPay ที่ตั้งผ่าน Backend
# ต้องสุ่มอย่างน้อย 32 ตัวอักษร เก็บเฉพาะฝั่ง server และห้ามเปลี่ยนหลังเริ่มบันทึกค่า
BACKEND_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret
# ชื่อเดิมยังรองรับเพื่อถอดรหัสค่า SMTP ที่มีอยู่ก่อน version นี้
SMTP_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Server-only bearer secret for the daily evidence-retention cron endpoint.
# Generate at least 32 random characters and never prefix the name with NEXT_PUBLIC_.
EVIDENCE_RETENTION_CRON_SECRET=replace-with-a-different-long-random-secret

# LINE (Phase 6) — ต้องสร้าง 2 channel แยกกันใน LINE Developers Console (provider เดียวกัน)
# 1) LINE Login channel — ใช้ตอน user เชื่อมบัญชี (ได้ LINE user ID มาเก็บใน users.line_user_id)
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
# 2) Messaging API channel — token เดียวของแอป ใช้ push ข้อความหาทุกคน (ไม่ใช่ token ต่อ user)
LINE_CHANNEL_ACCESS_TOKEN=your-line-messaging-channel-access-token

# Social login (Google/Facebook) เป็นค่า Supabase Auth ไม่ใช่ runtime setting ของแอป
# Local CLI: ใส่ค่าที่นี่ เปิด enabled=true ใน supabase/config.toml แล้ว restart Supabase
# Self-hosted production: ใส่ใน .env ของ Supabase Compose แล้ว recreate เฉพาะ auth service
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
