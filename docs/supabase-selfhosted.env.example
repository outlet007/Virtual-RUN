# Safe deployment-specific setting for the separate Supabase self-hosted stack.
# Keep the externally reachable Supavisor session-mode port on the default
# PostgreSQL port. The effective Docker mapping is host 5432 -> container 5432.
# Copy this value into the Supabase self-hosted `.env`; do not commit that real
# environment file because it also contains production secrets.
POSTGRES_PORT=5432
