# Copy this file to .env on the production server. Never commit the real .env.
# Replace every REQUIRED value before running Docker Compose.

# Application and container timezone. Keep NTP enabled on the host for JWT validation.
TZ=Asia/Bangkok

# Public application origin (no trailing slash)
SITE_URL=https://vrrun.bu.ac.th
# Public contact shown on the privacy and data-deletion pages.
PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=https://vrrun.bu.ac.th

# Public self-hosted Supabase API URL (not the Studio URL)
NEXT_PUBLIC_SUPABASE_URL=https://REQUIRED-SUPABASE-DOMAIN
SUPABASE_URL=https://REQUIRED-SUPABASE-DOMAIN

# Preferred self-hosted API keys from `sh run.sh secrets`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REQUIRED-SUPABASE-PUBLISHABLE-KEY
SUPABASE_SECRET_KEY=REQUIRED-SUPABASE-SECRET-KEY

# Leave these blank when using the preferred keys above. For a legacy Supabase
# deployment, blank the preferred keys and provide ANON_KEY / SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile is required for the login form.
TURNSTILE_SITE_KEY=REQUIRED-TURNSTILE-SITE-KEY
TURNSTILE_SECRET_KEY=REQUIRED-TURNSTILE-SECRET-KEY
TURNSTILE_EXPECTED_HOSTNAME=vrrun.bu.ac.th

# Optional integrations. Fill the values for features enabled in production.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

PROMPTPAY_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Virtual RUN <noreply@vrrun.bu.ac.th>"
# Required before saving an SMTP password through /admin/settings.
# Generate a private random value of at least 32 characters; never commit the real value.
BACKEND_SETTINGS_ENCRYPTION_KEY=REQUIRED-LONG-RANDOM-SECRET
# Legacy fallback for SMTP values saved before version 3.7.
SMTP_SETTINGS_ENCRYPTION_KEY=REQUIRED-LONG-RANDOM-SECRET

# Private bearer secret used only by the server cron request.
EVIDENCE_RETENTION_CRON_SECRET=REQUIRED-DIFFERENT-LONG-RANDOM-SECRET

LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
